# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your-key

# OpenAI (Embeddings only)
OPENAI_API_KEY=sk-your-key

# Stripe — server-side
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key

# Stripe — Payment Link URLs (create in Stripe Dashboard → Payment Links)
# Each link must have "client_reference_id" collection enabled
NEXT_PUBLIC_STRIPE_LINK_STARTER=https://buy.stripe.com/your-starter-link
NEXT_PUBLIC_STRIPE_LINK_PROFESSIONAL=https://buy.stripe.com/your-professional-link
NEXT_PUBLIC_STRIPE_LINK_FOUNDING_LEADER=https://buy.stripe.com/your-founding-leader-link

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

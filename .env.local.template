# QEP AISolve - Local Environment Variables
# Copy this file to .env.local and fill in your values from Vercel dashboard

# Supabase (from Vercel Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://fivmliegmqukdshfduld.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<paste from Vercel>
SUPABASE_SERVICE_ROLE_KEY=<paste from Vercel - REQUIRED for seeding>

# AI APIs (from Vercel Environment Variables)
ANTHROPIC_API_KEY=<paste from Vercel>
OPENAI_API_KEY=<paste from Vercel>

# Stripe — server-side keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<paste from Vercel>
STRIPE_SECRET_KEY=<paste from Vercel>
STRIPE_WEBHOOK_SECRET=<paste from Vercel>

# Stripe — Payment Link URLs (three-tier model)
# Create these in Stripe Dashboard → Payment Links
# Set success URL to: https://qep-aisolve.vercel.app/dashboard?upgraded=true
# Enable "client_reference_id" so webhook can identify the user
NEXT_PUBLIC_STRIPE_LINK_STARTER=<paste from Vercel>
NEXT_PUBLIC_STRIPE_LINK_PROFESSIONAL=<paste from Vercel>
NEXT_PUBLIC_STRIPE_LINK_FOUNDING_LEADER=<paste from Vercel>

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend) — https://resend.com/api-keys
# For local dev: set RESEND_API_KEY and leave EMAIL_FROM as onboarding@resend.dev
# For production: use your verified domain (see EMAIL_SETUP.md)
RESEND_API_KEY=<paste from Vercel>

# ============================================
# STRIPE WEBHOOK SETUP (one-time, in Stripe Dashboard)
# ============================================
# Endpoint URL: https://qep-aisolve.vercel.app/api/webhooks/stripe
# Events to listen for:
#   - checkout.session.completed
#   - customer.subscription.updated
#   - customer.subscription.deleted
# ============================================

